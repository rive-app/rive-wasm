{
  "npm": {
    "publish": false
  },
  "git": {
    "addUntrackedFiles": true,
    "commitMessage": "chore: tag ${version}",
    "requireCleanWorkingDir": false
  },
  "github": {
    "release": true,
    "releaseName": "${version}",
    "releaseNotes": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs"
  },
  "hooks": {
    "after:version:bump": [
      "npm run bumpVersions",
      "npm run build:all",
      "npm test",
      "npm run changelog",
      "npm run publish:all",
      "git add ../CHANGELOG.md"
    ]
  }
}
